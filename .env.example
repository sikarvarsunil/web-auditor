# anthropic (Claude), ollama, or openai (any OpenAI-compatible server)
AUDIT_PROVIDER=anthropic

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Used when AUDIT_PROVIDER=ollama. The model must accept images.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava
OLLAMA_TIMEOUT_SECONDS=180

# Used when AUDIT_PROVIDER=openai. Works with Ollama /v1, LM Studio, vLLM, and llama.cpp.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=not-required
OPENAI_MODEL=llava
OPENAI_TIMEOUT_SECONDS=180

MAX_UPLOAD_MB=8
BACKEND_PORT=8000
